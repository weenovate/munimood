# ============================================================
# MuniMood — Variables de Entorno
# Copiar este archivo como .env y completar los valores
# ============================================================

# ------------------------------------------------------------------
# Base de datos MySQL
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=munimood
DB_USER=munimood_user
DB_PASSWORD=TuContraseñaSegura

# ------------------------------------------------------------------
# Seguridad — JWT
# Generá una clave aleatoria con: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
SESSION_EXPIRE_MINUTES=480

# ------------------------------------------------------------------
# URL pública de la app (para links en emails de reset de contraseña)
# ------------------------------------------------------------------
APP_URL=http://tu-dominio.com.ar

# ------------------------------------------------------------------
# SMTP — Credenciales de correo para restablecer contraseña
# *** MODIFICAR ESTOS VALORES ANTES DE USAR LA APP ***
# ------------------------------------------------------------------
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=usuario@tu-dominio.com.ar
SMTP_PASSWORD=tu-contraseña-smtp
SMTP_FROM=noreply@tu-dominio.com.ar
SMTP_USE_TLS=true

# ------------------------------------------------------------------
# Redes sociales — Credenciales de scraping (opcionales)
# Recomendadas para acceder a más datos
# ------------------------------------------------------------------
INSTAGRAM_USERNAME=tu_usuario_instagram
INSTAGRAM_PASSWORD=tu_contraseña_instagram

FACEBOOK_EMAIL=tu_email_facebook
FACEBOOK_PASSWORD=tu_contraseña_facebook

# Cookies del navegador (método preferido desde VPS — evita bloqueos de login)
# Ver instrucciones en INSTALL.md para exportar el archivo cookies.txt
FACEBOOK_COOKIES_FILE=/home/tu_usuario/munimood/facebook_cookies.txt

# Twitter/X API v2 (Bearer Token — obtener en developer.twitter.com)
TWITTER_BEARER_TOKEN=

# ------------------------------------------------------------------
# CORS — Orígenes permitidos (separados por coma)
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
